# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/akssada
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=devpass

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@akssada.org
ADMIN_PASSWORD=changeme

# S3-Compatible Object Storage (required for media uploads)
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
S3_BUCKET_NAME=akssada-media
# Optional: for non-AWS S3-compatible providers (e.g., Cloudflare R2, MinIO)
S3_ENDPOINT=
# Public base URL for uploaded files (leave blank to auto-derive from AWS)
S3_PUBLIC_URL=

# Optional
LOG_LEVEL=INFO
PORT=8080
